# WikiSTAR configuration
# Copy to config.toml next to this file. NEVER commit config.toml.
# Every key can also be set as an environment variable of the same name,
# which takes precedence over this file.

SECRET_KEY = "replace-with-a-long-random-secret-key"

# SQLAlchemy database URL.
#   Local dev (default if omitted): "sqlite:///instance/dev.db"
#   Toolforge:  "mysql+pymysql://s12345:password@tools.db.svc.wikimedia.cloud/s12345__wikistar"
DATABASE_URL = "sqlite:///instance/dev.db"

# MediaWiki OAuth 2.0 credentials
# Register at: https://meta.wikimedia.org/wiki/Special:OAuthConsumerRegistration
CONSUMER_KEY = ""
CONSUMER_SECRET = ""

# Base URL of the OAuth server (meta.wikimedia.org for global Wikimedia auth)
OAUTH_MWURI = "https://meta.wikimedia.org"

# Set true behind HTTPS (required on Toolforge)
SESSION_COOKIE_SECURE = false

# Where to send the browser after login/logout (the SPA root)
FRONTEND_URL = "/"
